# Babycat — environment variable template
# Usage: cp .env.example .env && fill in values. The actual .env is gitignored and not tracked.

# The Jetson's externally reachable IP (zerotier or LAN). Advertised as a WebRTC
# ICE candidate. If empty, browsers (other nodes) can't reach mediamtx and WebRTC fails.
# Comma-separated for multiple (e.g. 192.168.1.10,172.27.1.205,etc.).
HOST_IP=127.0.0.1

# Container-local timezone. Clip/event date filters follow this calendar day.
TZ=Asia/Seoul

# JWT signing secret (injected into the router container only;
# NFR-013 — do not use the default in production).
JWT_SECRET=babycat-default-secret

# Access-token lifetime in seconds.
JWT_EXPIRY=600

# Refresh-token lifetime in seconds.
REFRESH_EXPIRY=2592000

# Extra CORS origins, comma-separated. Localhost/private-network origins are
# already allowed; needed only for dashboards served from other domains.
CORS_EXTRA_ORIGINS=

# Candidate VLM model list (comma-separated). The first entry is the boot default.
# Additional models are compiled in a subprocess at boot when the .so is missing
# (minutes to tens of minutes per model), then cached.
# Currently only VILA1.5-3b is in operation. Additional candidates are limited to
# NanoLLM-supported 3B-class VLMs that fit on Orin NX 16GB (no concurrent loading;
# switching is .so-cache-based load only).
# e.g. Efficient-Large-Model/VILA-2.7b,Efficient-Large-Model/VILA-7b,Efficient-Large-Model/VILA-13b,Efficient-Large-Model/VILA1.5-13b
VLM_MODELS=Efficient-Large-Model/VILA1.5-3b

# Upper bound on tokens generated per VLM inference. Counted in tokens (not
# characters); for English, 1 token ≈ 4 characters, Korean is shorter.
# Stop markers (</s>, <|im_end|>, etc.) may truncate earlier. Raise this when
# the default prompt elicits sentences that get cut off mid-word.
MAX_NEW_TOKENS=32

# Minimum seconds between inference starts (FR-058). 0 keeps the natural pace
# (inference latency bounds the cycle). A floor rate-limits only fast devices:
# e.g. 10 gives ~8,640 inferences/day on AGX Orin while Orin NX (4–6s natural)
# is unaffected. Occupancy stays comparable across devices because /summary
# carries per-bucket totals as the denominator (FR-057).
MIN_INFER_INTERVAL=0

# ── Inference window tuning (NOT YET WIRED through docker-compose) ──
# Defaults in analyzer/main.py:
#   N_FRAMES   = 4    # frames pulled from the ring per inference (≈ window length)
#   TARGET_FPS = 1.0  # videorate normalization rate, i.e. one frame per second
# Default window: (N_FRAMES - 1) / TARGET_FPS = 3s. To widen the window, lower
# TARGET_FPS or raise N_FRAMES, then forward them in the compose analyzer service.
# N_FRAMES=4
# TARGET_FPS=1.0

# ── Event clip recording (recorder) ──

# Detections within this window (seconds) count as one ongoing event (FR-030).
TRIGGER_COOLDOWN=30

# Base clip length in seconds; also the fallback-recording duration.
TRIGGER_CLIP_DUR=5

# Clip window around the trigger frame, in seconds.
# POST follows TRIGGER_CLIP_DUR when unset.
TRIGGER_PRE_EVENT_SEC=2
# TRIGGER_POST_EVENT_SEC=5

# Auto-prune old clips (FR-033) when free space drops below MIN, until TARGET.
CLIP_MIN_FREE_MB=512
CLIP_TARGET_FREE_MB=1024

# Inference-history retention in days (FR-053). Rows older than this are pruned
# hourly. Independent of clip pruning — FR-033 never touches inference history.
INFERENCE_RETENTION_DAYS=90

# Segment re-encode bitrate in bps.
RECORDER_ENCODE_BITRATE=4000000

# The camera's actual frame rate. Sizes the keyframe interval only; the stream
# is not resampled.
RECORDER_ENCODE_FPS=30

# Initial admin account (seeded once on first boot).
DEFAULT_USER=admin
DEFAULT_PASS=admin
