# Babycat — environment variable template
# Usage: cp .env.example .env && fill in values. The actual .env is gitignored and not tracked.
# Every variable here is read by docker-compose.yml; values fixed by the
# deployment (paths, internal URLs) are set in docker-compose.yml itself.

# The Jetson's externally reachable IP (LAN or VPN). Advertised as a WebRTC
# ICE candidate (MTX_WEBRTCADDITIONALHOSTS). Required: compose refuses to
# start when it is empty. Comma-separated for multiple (e.g. 192.168.1.10,172.27.1.205).
HOST_IP=

# Container-local timezone. Clip/event date filters follow this calendar day.
TZ=Asia/Seoul

# JWT signing secret (router only). Required and has no default: leaving it
# empty stops the router from starting (NFR-013). Use a long random string.
JWT_SECRET=

# Access-token lifetime in seconds (FR-001).
JWT_EXPIRY=600

# Refresh-token lifetime in seconds (FR-002).
REFRESH_EXPIRY=2592000

# Extra CORS origins, comma-separated. Localhost, private-network, and the
# Capacitor Android origins are already allowed.
CORS_EXTRA_ORIGINS=

# Candidate VLM model list (comma-separated). The first entry is the boot default.
# Models without a compiled cache are compiled in a subprocess at boot (minutes
# to tens of minutes per model), then cached under data/models.
# Candidates are limited to NanoLLM-supported 3B-class VLMs (NFR-023),
# e.g. Efficient-Large-Model/VILA-2.7b,Efficient-Large-Model/VILA1.5-3b
VLM_MODELS=Efficient-Large-Model/VILA1.5-3b

# Upper bound on tokens generated per VLM inference. Counted in tokens (not
# characters); for English, 1 token ≈ 4 characters, Korean is shorter.
# Stop markers (</s>, <|im_end|>, etc.) may truncate earlier. Raise this when
# the default prompt elicits sentences that get cut off mid-word.
MAX_NEW_TOKENS=32

# Minimum seconds between inference starts (FR-058). 0 keeps the natural pace
# (inference latency bounds the cycle). A floor rate-limits only fast devices:
# e.g. 10 gives ~8,640 inferences/day on AGX Orin. Occupancy stays comparable
# across devices because /summary carries per-bucket totals as the denominator
# (FR-057). The effective value is exposed as cfg_min_infer_interval in /state.
MIN_INFER_INTERVAL=0

# Frame extraction rate (frames per second fed to the ring) and frames per
# inference. The inference window is (N_FRAMES - 1) / TARGET_FPS seconds.
TARGET_FPS=1.0
N_FRAMES=4

# Ceilings in seconds for loading a VLM child from its compiled cache and for
# one inference call. Exceeding them counts as a failure.
VLM_LOAD_TIMEOUT=1800
VLM_INFER_TIMEOUT=120

# ── Event clip recording (recorder) ──

# Detections within this window (seconds) count as one ongoing event (FR-030).
TRIGGER_COOLDOWN=30

# Fallback recording length in seconds (direct RTSP capture when no segments
# cover the window); also the default for TRIGGER_POST_EVENT_SEC.
TRIGGER_CLIP_DUR=5

# Clip window around the trigger frame, in seconds.
# POST follows TRIGGER_CLIP_DUR when unset.
TRIGGER_PRE_EVENT_SEC=2
# TRIGGER_POST_EVENT_SEC=5

# Auto-prune the oldest clips (FR-033) when free space drops below MIN, until
# TARGET is reached. Pruned clips are gone for good (NFR-010).
CLIP_MIN_FREE_MB=512
CLIP_TARGET_FREE_MB=1024

# Inference-history retention in days (FR-053). Rows older than this are pruned
# hourly. Independent of clip pruning — FR-033 never touches inference history.
INFERENCE_RETENTION_DAYS=90

# Segment re-encode bitrate in bps.
RECORDER_ENCODE_BITRATE=4000000

# The camera's actual frame rate. Sizes the keyframe interval only; the stream
# is not resampled.
RECORDER_ENCODE_FPS=30

# Initial admin account (seeded once on first boot).
DEFAULT_USER=admin
DEFAULT_PASS=admin
