# Babycat gateway — TLS termination (HTTPS for the single entry point 8000).
# Serves a single certificate (data/caddy/site/) carrying every connection host in the SAN —
# because browsers connecting by IP send no SNI, so per-name certificate selection does
# not work. Issuance, renewal and adding connection hosts are performed by issue-cert.sh.
# cert.pem is the chain of the leaf and the signing CA (data/caddy/caddy/pki/authorities/local/root.crt),
# and clients trust the manufacturer Root CA (product) or that self-made CA (development)
# — see the babycat-ca repository.
{
	auto_https off
}

https://:8000 {
	tls /data/site/cert.pem /data/site/key.pem
	# Pass streaming responses such as SSE (/state) and MJPEG (/stream) through without buffering
	reverse_proxy router:8000 {
		flush_interval -1
	}
}
