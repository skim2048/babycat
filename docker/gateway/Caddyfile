# Babycat gateway — TLS 종단 (단일 진입점 8000의 HTTPS 전환).
# 모든 접속 호스트를 SAN에 담은 단일 인증서(data/caddy/site/)를 서빙한다 —
# IP로 접속하는 브라우저는 SNI를 보내지 않아 이름별 인증서 선택이 동작하지
# 않기 때문이다. 발급·갱신과 접속 호스트 추가는 issue-cert.sh가 수행하며,
# 서명 주체인 CA 루트(data/caddy/caddy/pki/authorities/local/root.crt)를
# 클라이언트(브라우저 신뢰 저장소, mewly 앱 res/raw)에 1회 설치한다.
{
	auto_https off
}

https://:8000 {
	tls /data/site/cert.pem /data/site/key.pem
	# SSE(/state)·MJPEG(/stream) 등 스트리밍 응답을 버퍼링 없이 통과시킨다
	reverse_proxy router:8000 {
		flush_interval -1
	}
}
